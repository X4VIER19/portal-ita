# -----------------------------------------------------------------------------
# Portal Cautivo ITA — plantilla de configuración local
# -----------------------------------------------------------------------------
# Copia este archivo como .env y sustituye TODOS los valores de ejemplo.
# Nunca subas .env, tokens OAuth, contraseñas ni certificados al repositorio.

# Servidor del portal
PORT=3000
# IP o nombre visible del portal; se usa al generar un certificado de laboratorio.
PORTAL_IP=192.168.1.100
# Genera un valor aleatorio largo y único para cada entorno.
SESSION_SECRET=reemplazar_por_un_secreto_aleatorio_largo
# Nivel mínimo de logs: debug, info, warn o error.
LOG_LEVEL=info
# Diagnóstico temporal de redirecciones de Omada. Por defecto permanece apagado;
# al activarlo solo guarda metadatos sin valores de parámetros, headers ni cookies.
OMADA_CAPTURE_REQUESTS=false

# MySQL
# MYSQL_ROOT_PASSWORD solo la utiliza Docker Compose al crear MySQL por primera vez.
MYSQL_ROOT_PASSWORD=reemplazar_por_contrasena_root_local
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=portal_ita
MYSQL_USER=portal_ita_user
MYSQL_PASSWORD=reemplazar_por_contrasena_mysql

# TP-Link Omada Open API
# Debe incluir el protocolo y no terminar con una barra diagonal.
OMADA_URL=https://omada-controller.example
OMADA_OMADAC_ID=reemplazar_por_id_del_controller
OMADA_SITE_ID=reemplazar_por_id_del_sitio
OMADA_CLIENT_ID=reemplazar_por_client_id_oauth
OMADA_CLIENT_SECRET=reemplazar_por_client_secret_oauth
