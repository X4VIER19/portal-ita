<%- include('../partials/head', { titulo: 'Error' }) %>
<body>
    <style>
        body {
            background: var(--color-fondo-app);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            text-align: center;
        }
        .caja {
            max-width: 420px;
        }
        h1 { color: var(--color-texto-titulo); margin-bottom: 0.75rem; }
        p { color: var(--color-texto-tenue); margin-bottom: 1.5rem; }
        a {
            display: inline-block;
            padding: 0.7rem 1.5rem;
            background: var(--color-marca-primario);
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
        }
        a:hover { background: var(--color-marca-primario-hover); }
    </style>

    <div class="caja">
        <h1>Algo salió mal</h1>
        <p><%= mensaje %></p>
        <a href="/admin/inicio">Volver al inicio</a>
    </div>
</body>
</html>