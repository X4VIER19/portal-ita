<%- include('../partials/head', { titulo: 'Inicio' }) %>

<body>

    <div class="app-shell">

        <%- include('../partials/sidebar', {
            activo: 'inicio',
            admin: {
                nombre,
                apellido,
                rol
            }
        }) %>

        <div class="contenido-principal">
            <%- include('../partials/topbar', {
                tituloSeccion: 'Inicio'
            }) %>

            <main class="contenido-pagina">
                <section class="inicio-dashboard">
                    <div class="inicio-bienvenida">
                        <h1>
                            Bienvenido, <%= nombre %>
                        </h1>
                    </div>

                    <% if (sync === 'ok') { %>
                        <div class="inicio-alerta inicio-alerta-exito">
                            <div>
                                <strong>
                                    Sesiones de Omada actualizadas.
                                </strong>

                                <% if (eliminadas > 0) { %>
                                    <span>
                                        Se eliminaron
                                        <%= eliminadas %>
                                        sesión<%= eliminadas === 1 ? '' : 'es' %>
                                        que ya no estaban activas.
                                    </span>
                                <% } else { %>
                                    <span>
                                        No se encontraron sesiones
                                        que necesitaran eliminarse.
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <% if (sync === 'error') { %>
                        <div class="inicio-alerta inicio-alerta-error">
                            No fue posible actualizar las sesiones
                            desde Omada. Los datos mostrados corresponden
                            al estado registrado actualmente en la base de datos.
                        </div>
                    <% } %>

                    <section class="resumen-grid">

                        <article class="stat-card">
                            <div class="stat-card-contenido">
                                <span class="stat-card-etiqueta">
                                    Usuarios totales
                                </span>

                                <strong class="stat-card-valor">
                                    <%= resumen.usuariosTotales %>
                                </strong>
                            </div>
                        </article>

                        <article class="stat-card">
                            <div class="stat-card-contenido">
                                <span class="stat-card-etiqueta">
                                    Sesiones registradas
                                </span>

                                <strong class="stat-card-valor">
                                    <%= resumen.sesionesActivas %>
                                </strong>
                            </div>
                        </article>

                        <article class="stat-card">
                            <div class="stat-card-contenido">
                                <span class="stat-card-etiqueta">
                                    Docentes activos
                                </span>

                                <strong class="stat-card-valor">
                                    <%= resumen.docentesActivos %>
                                </strong>
                            </div>
                        </article>

                        <article class="stat-card">
                            <div class="stat-card-contenido">
                                <span class="stat-card-etiqueta">
                                    Alumnos activos
                                </span>

                                <strong class="stat-card-valor">
                                    <%= resumen.alumnosActivos %>
                                </strong>
                            </div>
                        </article>

                    </section>

                    <section class="inicio-acciones">

                        <div class="inicio-seccion-header">
                            <div>
                                <h2>Acciones rápidas</h2>
                                <p>
                                    Operaciones frecuentes del panel
                                    administrativo.
                                </p>
                            </div>
                        </div>

                        <div class="acciones-grid">

                            <a
                                href="/admin/usuarios/nuevo"
                                class="accion-card"
                                data-abrir-modal-usuario
                            >
                                <span class="accion-card-icon">
                                    +
                                </span>

                                <span class="accion-card-texto">
                                    <strong>
                                        Crear usuario
                                    </strong>

                                    <small>
                                        Registrar una nueva cuenta
                                    </small>
                                </span>
                            </a>

                            <form
                                action="/admin/inicio/sincronizar"
                                method="POST"
                                class="accion-form"
                            >
                                <button
                                    type="submit"
                                    class="accion-card accion-card-button"
                                >
                                    <span class="accion-card-icon">
                                        ↻
                                    </span>

                                    <span class="accion-card-texto">
                                        <strong>
                                            Actualizar sesiones de Omada
                                        </strong>

                                        <small>
                                            Comprobar las sesiones
                                            actualmente autenticadas
                                        </small>
                                    </span>
                                </button>
                            </form>

                        </div>

                        <% if (actualizadoEn) { %>
                            <p class="inicio-actualizacion">
                                Última actualización manual de Omada:
                                <time
                                    datetime="<%= actualizadoEn %>"
                                    id="ultima-actualizacion"
                                >
                                    <%= actualizadoEn %>
                                </time>
                            </p>
                        <% } %>
                    </section>
                </section>
            </main>
        </div>
    </div>



    <style>

        .inicio-dashboard {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
        }

        .inicio-bienvenida {
            margin-bottom: 28px;
        }

        .inicio-bienvenida h1 {
            margin: 0;
            color: var(--color-texto-titulo);
            font-size: clamp(1.5rem, 2vw, 1.9rem);
            font-weight: 650;
            letter-spacing: -0.025em;
        }

        .resumen-grid {
            display: grid;
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 30px;
        }

        .stat-card {
            min-height: 145px;
            display: flex;
            align-items: stretch;
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: 14px;
            overflow: hidden;
            box-sizing: border-box;
        }

        .stat-card-contenido {
            width: 100%;
            padding: 22px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .stat-card-etiqueta {
            color: var(--color-texto-tenue);
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.01em;
        }

        .stat-card-valor {
            color: var(--color-texto-titulo);
            font-size: clamp(2rem, 3vw, 2.6rem);
            line-height: 1;
            font-weight: 650;
            letter-spacing: -0.04em;
        }

        .inicio-acciones {
            padding: 24px;
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: 14px;
        }

        .inicio-seccion-header {
            margin-bottom: 18px;
        }

        .inicio-seccion-header h2 {
            margin: 0 0 5px;
            color: var(--color-texto-titulo);
            font-size: 1rem;
            font-weight: 650;
        }

        .inicio-seccion-header p {
            margin: 0;
            color: var(--color-texto-tenue);
            font-size: 0.82rem;
        }

        .acciones-grid {
            display: grid;
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .accion-form {
            margin: 0;
            padding: 0;
        }

        .accion-card {
            width: 100%;
            min-height: 84px;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 17px;
            box-sizing: border-box;

            background: var(--color-fondo-app);
            border: 1px solid var(--color-borde);
            border-radius: 10px;

            color: var(--color-texto-normal);
            text-decoration: none;

            cursor: pointer;

            transition:
                background-color 0.15s ease,
                border-color 0.15s ease,
                transform 0.15s ease;
        }

        .accion-card:hover {
            background: var(--color-sidebar-hover);
            border-color: var(--color-marca-primario-hover);
            transform: translateY(-1px);
        }

        .accion-card-button {
            appearance: none;
            font: inherit;
            text-align: left;
        }

        .accion-card-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background: rgba(
                var(--color-marca-primario-rgb),
                0.18
            );

            color: var(--color-texto-titulo);

            font-size: 1.35rem;
            font-weight: 500;
        }

        .accion-card-texto {
            min-width: 0;

            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .accion-card-texto strong {
            color: var(--color-texto-titulo);
            font-size: 0.88rem;
            font-weight: 600;
        }

        .accion-card-texto small {
            color: var(--color-texto-tenue);
            font-size: 0.75rem;
            line-height: 1.35;
        }

        .inicio-actualizacion {
            margin: 16px 0 0;
            color: var(--color-texto-tenue);
            font-size: 0.74rem;
        }

        .inicio-alerta {
            margin-bottom: 18px;
            padding: 13px 16px;
            border-radius: 9px;
            font-size: 0.82rem;
            line-height: 1.45;
        }

        .inicio-alerta span {
            display: block;
            margin-top: 3px;
        }

        .inicio-alerta-exito {
            color: var(--color-exito);
            background: var(--color-exito-fondo);
            border: 1px solid rgba(
                79,
                180,
                119,
                0.25
            );
        }

        .inicio-alerta-error {
            color: var(--color-peligro);
            background: var(--color-peligro-fondo);
            border: 1px solid rgba(
                232,
                129,
                77,
                0.25
            );
        }

        @media (max-width: 900px) {

            .resumen-grid {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

        }

        @media (max-width: 600px) {

            .resumen-grid,
            .acciones-grid {
                grid-template-columns: 1fr;
            }

            .inicio-acciones {
                padding: 18px;
            }

            .stat-card {
                min-height: 125px;
            }

        }

    </style>

    <script>
        (() => {
            const elemento =
                document.getElementById(
                    "ultima-actualizacion"
                );

            if (!elemento) {
                return;
            }

            const fecha =
                new Date(elemento.dateTime);

            if (Number.isNaN(fecha.getTime())) {
                return;
            }

            elemento.textContent =
                fecha.toLocaleString(
                    "es-MX",
                    {
                        dateStyle: "medium",
                        timeStyle: "short"
                    }
                );
        })();
    </script>

    <%- include('../partials/modal-usuario') %>
</body>
</html>