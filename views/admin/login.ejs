<%- include('../partials/head', { titulo: 'Iniciar Sesión', hojasEstilo: ['portal'] }) %>
<body class="portal-login-page">

    <div class="marca-superior">
        <p class="sigla">Instituto Tecnológico de Altamira</p>
        <p class="titulo">Panel de administración</p>
    </div>

    <div class="card acceso-card">
        <h1>Iniciar sesión</h1>
        <p class="subtitulo">Accede con tu cuenta de administrador</p>

        <div class="acceso-contenido">
            <form method="POST" action="/admin/login">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <% if (error) { %>
                    <div class="mensaje-formulario error"><%= error %></div>
                <% } %>

                <div class="campo">
                    <label for="correo">Correo institucional</label>
                    <input id="correo" name="correo" type="email" placeholder="usuario@altamira.tecnm.mx" autocomplete="username" required autofocus>
                </div>

                <div class="campo">
                    <label for="password">Contraseña</label>
                    <div class="campo-password-login">
                        <input id="password" name="password" type="password" placeholder="Ingresa tu contraseña" required>
                        <button type="button" class="toggle-password-login" data-toggle-password-login aria-label="Mostrar contraseña">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit">Entrar</button>
            </form>
        </div>
    </div>

    <%- include('../partials/toggle-password-login') %>
</body>
</html>
