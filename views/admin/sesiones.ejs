<%- include('../partials/head', { titulo: 'Sesiones activas' }) %>
<body>
    <style>
        .aviso {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--color-peligro-fondo);
            color: var(--color-peligro);
            padding: 0.75rem 1rem;
            border-radius: var(--radio-base);
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
        }

        .aviso-exito {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--color-exito-fondo);
            color: var(--color-exito);
            padding: 0.75rem 1rem;
            border-radius: var(--radio-base);
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
        }

        .toolbar-sesiones {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 1rem;
        }

        .btn-sincronizar {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 0.9rem;
            border-radius: var(--radio-base);
            border: 1px solid var(--color-borde);
            background: var(--color-superficie);
            color: var(--color-texto-normal);
            font-size: 0.84rem;
            cursor: pointer;
        }

        .btn-sincronizar:hover {
            border-color: var(--color-marca-primario-hover);
            color: #ffffff;
        }

        .filtros {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            flex-wrap: wrap;
            margin-bottom: 1.25rem;
        }

        .campo-busqueda { flex: 1 1 300px; min-width: 220px; }

        .campo-busqueda input,
        .filtros select {
            width: 100%;
            min-height: 38px;
            box-sizing: border-box;
            padding: 0.55rem 0.75rem;
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: var(--radio-base);
            color: var(--color-texto-normal);
            font: inherit;
            outline: none;
        }

        .filtros select {
            width: 160px;
            flex-shrink: 0;
        }
        .campo-busqueda input:focus, .filtros select:focus { border-color: var(--color-marca-primario); }

        .btn-filtro, .btn-limpiar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-height: 38px;
            box-sizing: border-box;
            padding: 0.55rem 0.9rem;
            border-radius: var(--radio-base);
            font-size: 0.84rem;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-filtro {
            border: 1px solid var(--color-marca-primario);
            background: var(--color-marca-primario);
            color: #fff;
            cursor: pointer;
        }

        .btn-filtro:hover { background: var(--color-marca-primario-hover); }
        .btn-limpiar { border: 1px solid var(--color-borde); color: var(--color-texto-tenue); }
        .btn-limpiar:hover { color: var(--color-texto-normal); border-color: var(--color-texto-tenue); }

        .btn-limpiar.deshabilitado {
            opacity: 0.5;
            pointer-events: none;
            cursor: default;
        }

        .tabla-panel {
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: 12px;
            overflow: hidden;
        }

        .tabla-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 820px; }

        thead th {
            text-align: left;
            padding: 0.85rem 1.25rem;
            color: var(--color-texto-tenue);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--color-borde);
        }

        tbody td {
            padding: 0.9rem 1.25rem;
            border-bottom: 1px solid var(--color-borde);
            color: var(--color-texto-normal);
        }

        tbody tr:last-child td { border-bottom: none; }
        .mac { font-family: monospace; font-size: 0.85rem; color: var(--color-texto-tenue); }

        .badge {
            display: inline-block;
            padding: 0.25rem 0.6rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-activo { background: var(--color-exito-fondo); color: var(--color-exito); }
        .badge-expirado { background: var(--color-peligro-fondo); color: var(--color-peligro); }
        .badge-sin_registro { background: rgba(139, 150, 174, 0.16); color: var(--color-texto-tenue); }
        .badge-desconocido { background: rgba(139, 150, 174, 0.16); color: var(--color-texto-tenue); }

        .btn-desconectar {
            background: none;
            border: 1px solid var(--color-peligro);
            color: var(--color-peligro);
            padding: 0.4rem 0.8rem;
            border-radius: var(--radio-base);
            font-size: 0.8rem;
            cursor: pointer;
        }

        .btn-desconectar:hover { background: var(--color-peligro-fondo); }
        .vacio { padding: 2.5rem; text-align: center; color: var(--color-texto-tenue); }

        .paginacion {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            padding: 0.85rem 1.1rem;
            border-top: 1px solid var(--color-borde);
            color: var(--color-texto-tenue);
            font-size: 0.82rem;
        }

        .paginacion-controles { display: flex; align-items: center; gap: 0.25rem; }
        .pagina-boton, .pagina-numero {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            box-sizing: border-box;
            padding: 0 0.45rem;
            border: 1px solid transparent;
            border-radius: 6px;
            color: var(--color-texto-tenue);
            text-decoration: none;
            font-size: 0.8rem;
        }

        .pagina-boton { gap: 0.25rem; border-color: var(--color-borde); }
        .pagina-numero:hover, .pagina-boton:hover { color: var(--color-texto-normal); border-color: var(--color-borde); }
        .pagina-numero.actual { background: var(--color-info-fondo); color: var(--color-info); border-color: transparent; font-weight: 700; }
        .pagina-boton.deshabilitado { opacity: 0.45; pointer-events: none; }
        .pagina-ellipsis { padding: 0 0.25rem; }

        @media (max-width: 700px) {
            .filtros { flex-direction: column; align-items: stretch; }
            .campo-busqueda, .filtros select, .btn-filtro, .btn-limpiar { width: 100%; }
            .paginacion { align-items: stretch; flex-direction: column; }
            .paginacion-controles { justify-content: center; flex-wrap: wrap; }
            .pagina-boton span { display: none; }
        }
    </style>

    <div class="app-shell">
        <%- include('../partials/sidebar', {
            activo: 'sesiones',
            admin: { nombre, apellido, rol }
        }) %>

        <div class="contenido-principal">
            <%- include('../partials/topbar', { tituloSeccion: 'Sesiones activas' }) %>

            <main class="contenido-pagina">
                <% if (omadaError) { %>
                    <div class="aviso">
                        <i class="ph ph-warning"></i>
                        No se pudo verificar el estado en vivo con Omada. Se muestra únicamente
                        la información guardada localmente.
                    </div>
                <% } %>

                <% if (sync === "ok") { %>
                    <div class="aviso-exito">
                        <i class="ph ph-check-circle"></i>
                        Sincronización completada.
                        <% if (eliminadas > 0) { %>
                            Se limpiaron <strong><%= eliminadas %></strong> sesión(es) que ya no estaban vigentes en Omada.
                        <% } else { %>
                            Todas las sesiones registradas siguen vigentes en Omada.
                        <% } %>
                    </div>
                <% } else if (sync === "error") { %>
                    <div class="aviso">
                        <i class="ph ph-warning"></i>
                        No se pudo completar la sincronización porque Omada no respondió. Intenta de nuevo en unos minutos.
                    </div>
                <% } %>

                <div class="toolbar-sesiones">
                    <form method="POST" action="/admin/sesiones/sincronizar">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="busqueda" value="<%= busqueda %>">
                        <input type="hidden" name="rol" value="<%= filtroRol %>">
                        <button type="submit" class="btn-sincronizar">
                            <i class="ph ph-arrows-clockwise"></i> Sincronizar con Omada
                        </button>
                    </form>
                </div>

                <form method="GET" action="/admin/sesiones" class="filtros">
                    <div class="campo-busqueda">
                        <input
                            type="search"
                            name="busqueda"
                            value="<%= busqueda %>"
                            placeholder="Buscar por nombre, apellido, correo o MAC..."
                            aria-label="Buscar sesiones"
                        >
                    </div>

                    <select name="rol" aria-label="Filtrar por rol" onchange="this.form.submit()">
                        <option value="">Todos los roles</option>
                        <option value="admin" <%= filtroRol === 'admin' ? 'selected' : '' %>>Administrador</option>
                        <option value="docente" <%= filtroRol === 'docente' ? 'selected' : '' %>>Docente</option>
                        <option value="alumno" <%= filtroRol === 'alumno' ? 'selected' : '' %>>Alumno</option>
                    </select>

                    <button type="submit" class="btn-filtro">
                        <i class="ph ph-magnifying-glass"></i> Buscar
                    </button>

                    <a 
                        href="/admin/sesiones" 
                        class="btn-limpiar <%= !(busqueda || filtroRol) ? 'deshabilitado' : '' %>"
                    >
                        Limpiar
                    </a>
                </form>

                <div class="tabla-panel">
                    <% if (sesiones.length === 0) { %>
                        <div class="vacio">
                            <%= (busqueda || filtroRol)
                                ? 'No se encontraron sesiones con los criterios de búsqueda.'
                                : 'No hay sesiones activas en este momento.' %>
                        </div>
                    <% } else { %>
                        <div class="tabla-scroll">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Usuario</th>
                                        <th>MAC</th>
                                        <th>Autorizado desde</th>
                                        <th>Estado en Omada</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% sesiones.forEach(s => { %>
                                        <tr>
                                            <td>
                                                <%= s.nombre %> <%= s.apellido %><br>
                                                <span class="mac"><%= s.correo %></span>
                                            </td>
                                            <td class="mac"><%= s.mac %></td>
                                            <td><%= new Date(s.autorizado_en).toLocaleString('es-MX') %></td>
                                            <td>
                                                <span class="badge badge-<%= s.estadoOmada %>">
                                                    <%
                                                        const etiquetas = {
                                                            activo: 'Activo',
                                                            expirado: 'Expirado en Omada',
                                                            sin_registro: 'Sin registro',
                                                            desconocido: 'Sin verificar'
                                                        };
                                                    %>
                                                    <%= etiquetas[s.estadoOmada] %>
                                                </span>
                                            </td>
                                            <td>
                                                <form method="POST" action="/admin/sesiones/<%= s.usuario_id %>/desconectar">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <input type="hidden" name="mac" value="<%= s.mac %>">
                                                    <button type="submit" class="btn-desconectar">Desconectar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <%- include('../partials/paginacion', {
                            paginaActual,
                            totalPaginas,
                            total,
                            inicio,
                            fin,
                            ruta: '/admin/sesiones',
                            busqueda,
                            rol: filtroRol
                        }) %>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
