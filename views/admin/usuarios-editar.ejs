<%- include('../partials/head', { titulo: 'Editar usuario' }) %>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', {
            activo: 'usuarios',
            admin: { nombre, apellido, rol }
        }) %>

        <div class="contenido-principal">
            <%- include('../partials/topbar', { tituloSeccion: 'Editar usuario' }) %>

            <main class="contenido-pagina">
                <a href="/admin/usuarios" class="volver">&larr; Volver a usuarios</a>

                <div class="form-panel">
                    <% if (error) { %>
                        <div class="error-box"><%= error %></div>
                    <% } %>

                    <form method="POST" action="/admin/usuarios/editar/<%= valores.id %>" class="formulario-usuario" autocomplete="off">
                        <%- include('../partials/form-usuario-campos', {
                            valores,
                            modo: 'editar',
                            prefijo: ''
                        }) %>
                    </form>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
