<%- include('../partials/head', { titulo: 'Usuarios' }) %>
<body>
    <style>
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .filtros {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            flex-wrap: wrap;
            flex: 1;
        }

        .campo-busqueda { flex: 1 1 280px; min-width: 220px; }

        .campo-busqueda input,
        .filtros select {
            width: 100%;
            min-height: 38px;
            box-sizing: border-box;
            padding: 0.55rem 0.75rem;
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: var(--radio-base);
            color: var(--color-texto-normal);
            font: inherit;
            outline: none;
        }

        .filtros select { width: auto; min-width: 140px; }

        .campo-busqueda input:focus,
        .filtros select:focus {
            border-color: var(--color-marca-primario);
        }

        .btn-filtro,
        .btn-limpiar,
        .btn-nuevo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-height: 38px;
            box-sizing: border-box;
            padding: 0.55rem 0.9rem;
            border-radius: var(--radio-base);
            font-size: 0.84rem;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-filtro {
            border: 1px solid var(--color-marca-primario);
            background: var(--color-marca-primario);
            color: #fff;
            cursor: pointer;
        }

        .btn-filtro:hover { background: var(--color-marca-primario-hover); }

        .btn-limpiar {
            border: 1px solid var(--color-borde);
            color: var(--color-texto-tenue);
        }

        .btn-limpiar:hover { color: var(--color-texto-normal); border-color: var(--color-texto-tenue); }

        .btn-nuevo {
            flex-shrink: 0;
            background: var(--color-marca-primario);
            color: #fff;
            font-weight: 500;
        }

        .btn-nuevo:hover { background: var(--color-marca-primario-hover); }

        .tabla-panel {
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: 12px;
            overflow: hidden;
        }

        .tabla-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 760px; }

        thead th {
            text-align: left;
            padding: 0.85rem 1.25rem;
            color: var(--color-texto-tenue);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--color-borde);
        }

        tbody td {
            padding: 0.9rem 1.25rem;
            border-bottom: 1px solid var(--color-borde);
            color: var(--color-texto-normal);
        }

        tbody tr:last-child td { border-bottom: none; }

        .badge {
            display: inline-block;
            padding: 0.25rem 0.6rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-rol-admin { background: var(--color-info-fondo); color: var(--color-info); }
        .badge-rol-docente { background: rgba(79, 180, 119, 0.16); color: var(--color-exito); }
        .badge-rol-alumno { background: rgba(232, 129, 77, 0.16); color: var(--color-peligro); }
        .badge-activo { background: var(--color-exito-fondo); color: var(--color-exito); }
        .badge-inactivo { background: var(--color-peligro-fondo); color: var(--color-peligro); }

        .btn-toggle {
            display: inline-block;
            background: none;
            border: 1px solid var(--color-borde);
            color: var(--color-texto-tenue);
            padding: 0.4rem 0.8rem;
            border-radius: var(--radio-base);
            font-size: 0.8rem;
            text-decoration: none;
            margin-right: 0.4rem;
            cursor: pointer;
        }

        .btn-toggle:hover { border-color: var(--color-marca-primario-hover); color: var(--color-texto-normal); }

        .vacio {
            padding: 2.5rem;
            text-align: center;
            color: var(--color-texto-tenue);
        }

        tbody td:last-child { text-align: right; white-space: nowrap; }

        .paginacion {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            padding: 0.85rem 1.1rem;
            border-top: 1px solid var(--color-borde);
            color: var(--color-texto-tenue);
            font-size: 0.82rem;
        }

        .paginacion-controles { display: flex; align-items: center; gap: 0.25rem; }
        .pagina-boton, .pagina-numero {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            box-sizing: border-box;
            padding: 0 0.45rem;
            border: 1px solid transparent;
            border-radius: 6px;
            color: var(--color-texto-tenue);
            text-decoration: none;
            font-size: 0.8rem;
        }

        .pagina-boton { gap: 0.25rem; border-color: var(--color-borde); }
        .pagina-numero:hover, .pagina-boton:hover { color: var(--color-texto-normal); border-color: var(--color-borde); }
        .pagina-numero.actual { background: var(--color-info-fondo); color: var(--color-info); border-color: transparent; font-weight: 700; }
        .pagina-boton.deshabilitado { opacity: 0.45; pointer-events: none; }
        .pagina-ellipsis { padding: 0 0.25rem; }

        @media (max-width: 900px) {
            .toolbar { align-items: stretch; flex-direction: column; }
            .btn-nuevo { align-self: flex-start; }
        }

        @media (max-width: 620px) {
            .filtros { flex-direction: column; align-items: stretch; }
            .campo-busqueda, .filtros select, .btn-filtro, .btn-limpiar { width: 100%; }
            .paginacion { align-items: stretch; flex-direction: column; }
            .paginacion-controles { justify-content: center; flex-wrap: wrap; }
            .pagina-boton span { display: none; }
        }
    </style>

    <div class="app-shell">
        <%- include('../partials/sidebar', { activo: 'usuarios', admin: { nombre, apellido, rol } }) %>

        <div class="contenido-principal">
            <%- include('../partials/topbar', { tituloSeccion: 'Usuarios' }) %>

            <main class="contenido-pagina">
                <div class="toolbar">
                    <form method="GET" action="/admin/usuarios" class="filtros">
                        <div class="campo-busqueda">
                            <input
                                type="search"
                                name="busqueda"
                                value="<%= busqueda %>"
                                placeholder="Buscar por nombre, apellido o correo..."
                                aria-label="Buscar usuarios"
                            >
                        </div>

                        <select name="rol" aria-label="Filtrar por rol" onchange="this.form.submit()">
                            <option value="">Todos los roles</option>
                            <option value="admin" <%= rol === 'admin' ? 'selected' : '' %>>Administrador</option>
                            <option value="docente" <%= rol === 'docente' ? 'selected' : '' %>>Docente</option>
                            <option value="alumno" <%= rol === 'alumno' ? 'selected' : '' %>>Alumno</option>
                        </select>

                        <select name="estado" aria-label="Filtrar por estado" onchange="this.form.submit()">
                            <option value="">Todos los estados</option>
                            <option value="activo" <%= estado === 'activo' ? 'selected' : '' %>>Activo</option>
                            <option value="inactivo" <%= estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
                        </select>

                        <button type="submit" class="btn-filtro">
                            <i class="ph ph-magnifying-glass"></i> Buscar
                        </button>

                        <% if (busqueda || rol || estado) { %>
                            <a href="/admin/usuarios" class="btn-limpiar">Limpiar</a>
                        <% } %>
                    </form>

                    <a href="/admin/usuarios/nuevo" class="btn-nuevo">
                        <i class="ph ph-plus"></i> Nuevo usuario
                    </a>
                </div>

                <div class="tabla-panel">
                    <% if (usuarios.length === 0) { %>
                        <div class="vacio">
                            <%= (busqueda || rol || estado)
                                ? 'No se encontraron usuarios con los criterios de búsqueda.'
                                : 'Todavía no hay usuarios registrados.' %>
                        </div>
                    <% } else { %>
                        <div class="tabla-scroll">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Correo</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% usuarios.forEach(u => { %>
                                        <tr>
                                            <td><%= u.nombre %> <%= u.apellido %></td>
                                            <td><%= u.correo %></td>
                                            <td><span class="badge badge-rol-<%= u.rol %>"><%= u.rol %></span></td>
                                            <td>
                                                <span class="badge <%= u.activo ? 'badge-activo' : 'badge-inactivo' %>">
                                                    <%= u.activo ? 'Activo' : 'Inactivo' %>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/admin/usuarios/editar/<%= u.id %>" class="btn-toggle">Editar</a>
                                                <form method="POST" action="/admin/usuarios/<%= u.id %>/toggle" style="display:inline;">
                                                    <button type="submit" class="btn-toggle">
                                                        <%= u.activo ? 'Desactivar' : 'Activar' %>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <%- include('../partials/paginacion', {
                            paginaActual,
                            totalPaginas,
                            total,
                            inicio,
                            fin,
                            ruta: '/admin/usuarios',
                            busqueda,
                            rol,
                            estado
                        }) %>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
