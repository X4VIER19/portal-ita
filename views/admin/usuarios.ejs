<%- include('../partials/head', { titulo: 'Usuarios' }) %>
<body>

    <div class="app-shell">
        <%- include('../partials/sidebar', { activo: 'usuarios', admin: { nombre, apellido, rol } }) %>

        <div class="contenido-principal">
            <%- include('../partials/topbar', { tituloSeccion: 'Usuarios' }) %>

            <main class="contenido-pagina">
                <div class="toolbar">
                    <form method="GET" action="/admin/usuarios" class="filtros">
                        <div class="campo-busqueda">
                            <input
                                type="search"
                                name="busqueda"
                                value="<%= busqueda %>"
                                placeholder="Buscar por nombre, apellido o correo..."
                                aria-label="Buscar usuarios"
                            >
                        </div>

                        <select name="rol" aria-label="Filtrar por rol" onchange="this.form.submit()">
                            <option value="">Todos los roles</option>
                            <option value="admin" <%= filtroRol === 'admin' ? 'selected' : '' %>>Administrador</option>
                            <option value="docente" <%= filtroRol === 'docente' ? 'selected' : '' %>>Docente</option>
                            <option value="alumno" <%= filtroRol === 'alumno' ? 'selected' : '' %>>Alumno</option>
                        </select>

                        <select name="estado" aria-label="Filtrar por estado" onchange="this.form.submit()">
                            <option value="">Todos los estados</option>
                            <option value="activo" <%= estado === 'activo' ? 'selected' : '' %>>Activo</option>
                            <option value="inactivo" <%= estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
                        </select>

                        <button type="submit" class="btn-filtro">
                            <i class="ph ph-magnifying-glass"></i> Buscar
                        </button>

                        <a 
                            href="/admin/usuarios" 
                            class="btn-limpiar <%= !(busqueda || filtroRol || estado) ? 'deshabilitado' : '' %>"
                        >
                            Limpiar
                        </a>
                    </form>

                    <a href="/admin/usuarios/nuevo" class="btn-nuevo" data-abrir-modal-usuario>
                        <i class="ph ph-plus"></i> Nuevo usuario
                    </a>
                </div>

                <div class="tabla-panel">
                    <% if (usuarios.length === 0) { %>
                        <div class="vacio">
                            <%= (busqueda || filtroRol || estado)
                                ? 'No se encontraron usuarios con los criterios de búsqueda.'
                                : 'Todavía no hay usuarios registrados.' %>
                        </div>
                    <% } else { %>
                        <div class="tabla-scroll">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Correo</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% usuarios.forEach(u => { %>
                                        <tr>
                                            <td><%= u.nombre %> <%= u.apellido %></td>
                                            <td><%= u.correo %></td>
                                            <td><span class="badge badge-rol-<%= u.rol %>"><%= u.rol %></span></td>
                                            <td>
                                                <span class="badge <%= u.activo ? 'badge-activo' : 'badge-inactivo' %>">
                                                    <%= u.activo ? 'Activo' : 'Inactivo' %>
                                                </span>
                                                <% if (u.requiere_cambio_contrasena) { %>
                                                    <span class="badge">Cambio pendiente</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <a
                                                    href="/admin/usuarios/editar/<%= u.id %>"
                                                    class="btn-toggle"
                                                    data-editar-usuario="<%= JSON.stringify({ id: u.id, nombre: u.nombre, apellido: u.apellido, correo: u.correo, rol: u.rol }) %>"
                                                >Editar</a>
                                                <form method="POST" action="/admin/usuarios/<%= u.id %>/toggle" style="display:inline;">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn-toggle">
                                                        <%= u.activo ? 'Desactivar' : 'Activar' %>
                                                    </button>
                                                </form>
                                                <form method="POST" action="/admin/usuarios/<%= u.id %>/restablecer-contrasena" style="display:inline;" data-restablecer-contrasena>
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn-toggle">Restablecer contraseña</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <%- include('../partials/paginacion', {
                            paginaActual,
                            totalPaginas,
                            total,
                            inicio,
                            fin,
                            ruta: '/admin/usuarios',
                            busqueda,
                            rol: filtroRol,
                            estado
                        }) %>
                    <% } %>
                </div>
            </main>
        </div>
    </div>
    <%- include('../partials/modal-usuario') %>
    <%- include('../partials/modal-contrasena-provisional') %>
</body>
</html>
