<%
    const p = typeof prefijo !== 'undefined' ? prefijo : '';
    const editando = modo === 'editar';
    const v = valores || {};
    const usuarioInstitucional = typeof v.correo === 'string'
        ? v.correo.split('@')[0]
        : '';
%>


<input type="hidden" name="_csrf" value="<%= csrfToken %>">

<div class="campo">
    <label for="<%= p %>nombre">Nombre</label>
    <input id="<%= p %>nombre" name="nombre" type="text" value="<%= v.nombre || '' %>" required>
</div>

<div class="campo">
    <label for="<%= p %>apellido">Apellido</label>
    <input id="<%= p %>apellido" name="apellido" type="text" value="<%= v.apellido || '' %>" required>
</div>

<div class="campo">
    <label for="<%= p %>correo">Usuario institucional</label>
    <div class="correo-institucional">
        <input
            id="<%= p %>correo"
            name="correo"
            type="text"
            value="<%= usuarioInstitucional %>"
            placeholder="usuario"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            required
        >
        <span class="correo-dominio">@altamira.tecnm.mx</span>
    </div>
</div>

<div class="campo">
    <label for="<%= p %>rol">Rol</label>
    <select id="<%= p %>rol" name="rol" required>
        <option value="">Selecciona un rol</option>
        <option value="docente" <%= v.rol === 'docente' ? 'selected' : '' %>>Docente</option>
        <option value="alumno" <%= v.rol === 'alumno' ? 'selected' : '' %>>Alumno</option>
        <option value="admin" <%= v.rol === 'admin' ? 'selected' : '' %>>Admin</option>
    </select>
</div>

<button type="submit" class="btn-guardar">
    <%= editando ? 'Guardar cambios' : 'Crear usuario' %>
</button>
