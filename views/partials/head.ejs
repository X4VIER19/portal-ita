<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> | Portal ITA</title>
    <link rel="stylesheet" href="/styles/tokens.css">
    <link rel="stylesheet" href="/styles/base.css">
    <%
        const estilosPagina = typeof hojasEstilo !== 'undefined'
            ? hojasEstilo
            : ['layout', 'components', 'admin'];
    %>
    <% estilosPagina.forEach(hoja => { %>
        <link rel="stylesheet" href="/styles/<%= hoja %>.css">
    <% }) %>
    <link rel="stylesheet" href="/icons/phosphor/src/regular/style.css">
</head>
