<script>
    document.querySelectorAll("[data-toggle-password-login]").forEach((boton) => {
        boton.addEventListener("click", () => {
            const contenedor = boton.closest(".campo-password-login");
            const input = contenedor.querySelector("input");
            const icono = boton.querySelector("i");
            const mostrando = input.type === "text";

            input.type = mostrando ? "password" : "text";
            icono.className = mostrando ? "ph ph-eye" : "ph ph-eye-slash";
            boton.setAttribute(
                "aria-label",
                mostrando ? "Mostrar contraseña" : "Ocultar contraseña"
            );
        });
    });
</script>
