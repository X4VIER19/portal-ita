<%- include('../partials/head', { titulo: 'Portal ITA', hojasEstilo: ['portal'] }) %>
<body class="portal-login-page">

    <div class="marca-superior">
        <p class="sigla">Instituto Tecnológico de Altamira</p>
        <p class="titulo">Portal Cautivo</p>
    </div>

    <div class="card acceso-card">
        <h1>Acceder a la red</h1>
        <p class="subtitulo">Inicia sesión con tu cuenta institucional</p>

        <div class="acceso-contenido">
            <div class="dispositivo">
                Dispositivo detectado: <strong><%= clientMac %></strong>
            </div>

        <div class="campo">
            <label for="usuario">Usuario institucional</label>
            <div class="usuario-institucional">
                <input id="usuario" type="text" placeholder="usuario" autocomplete="username" autocapitalize="none" spellcheck="false">
                <span class="usuario-dominio">@altamira.tecnm.mx</span>
            </div>
        </div>

        <div class="campo">
            <label for="password">Contraseña</label>
            <div class="campo-password-login">
                <input id="password" type="password" placeholder="Contraseña" autocomplete="current-password">
                <button type="button" class="toggle-password-login" data-toggle-password-login aria-label="Mostrar contraseña">
                    <i class="ph ph-eye"></i>
                </button>
            </div>
        </div>

        <button id="btnLogin" onclick="login()">Acceder</button>
        <div id="mensaje"></div>
            <a class="enlace-restablecer" href="/restablecer">¿Recibiste una contraseña provisional?</a>
        </div>
    </div>

    <script>
        const CLIENT_MAC = <%- JSON.stringify(clientMac) %>;
        const REDIRECT_FINAL = <%- JSON.stringify(redirectUrl || "http://sii.altamira.tecnm.mx/").replace(/</g, "\\u003c") %>;
        const CSRF_TOKEN = <%- JSON.stringify(csrfToken) %>;

        async function login() {
            const boton = document.getElementById("btnLogin");
            const mensaje = document.getElementById("mensaje");
            const usuario = document.getElementById("usuario").value;
            const password = document.getElementById("password").value;

            boton.disabled = true;
            boton.innerText = "Verificando...";
            mensaje.className = "";
            mensaje.innerText = "";

            try {
                const resp = await fetch("/login", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRF-Token": CSRF_TOKEN
                    },
                    body: JSON.stringify({ usuario, password, clientMac: CLIENT_MAC })
                });
                const data = await resp.json();

                if (data.ok) {
                    mensaje.className = "exito";
                    mensaje.innerText = "Acceso concedido. Redirigiendo...";
                    setTimeout(() => { window.location.href = REDIRECT_FINAL; }, 1000);
                } else {
                    mensaje.className = "error";
                    mensaje.innerText = data.mensaje;
                    if (data.codigo === "CAMBIO_CONTRASENA_REQUERIDO") {
                        const enlace = document.querySelector(".enlace-restablecer");
                        enlace.focus();
                    }
                    boton.disabled = false;
                    boton.innerText = "Acceder";
                }
            } catch (err) {
                mensaje.className = "error";
                mensaje.innerText = "Error de conexión con el servidor.";
                boton.disabled = false;
                boton.innerText = "Acceder";
            }
        }
    </script>
    <%- include('../partials/toggle-password-login') %>
</body>
</html>
