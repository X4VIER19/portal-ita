<%- include('../partials/head', { titulo: 'Portal ITA' }) %>
<body>
    <style>
        body {
            background-image:
                linear-gradient(160deg, rgba(8,14,26,0.92) 0%, rgba(8,14,26,0.80) 60%, rgba(8,14,26,0.90) 100%),
                url('/assets/fondo_ITA.webp');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: scroll;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: clamp(1rem, 5vw, 2rem);
        }

        .marca-superior { text-align: center; margin-bottom: clamp(1.25rem, 4vw, 1.75rem); }

        .marca-superior .sigla {
            font-size: 0.78rem;
            letter-spacing: 0.03em;
            color: var(--color-texto-tenue);
            margin-bottom: 0.25rem;
        }

        .marca-superior .titulo {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--color-texto-titulo);
        }

        .card {
            background: var(--color-superficie);
            border: 1px solid var(--color-borde);
            border-radius: 16px;
            padding: 2.75rem 2.25rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.35);
        }

        @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
            .card {
                background: rgba(19, 27, 46, 0.42);
                backdrop-filter: blur(18px) saturate(140%);
                -webkit-backdrop-filter: blur(18px) saturate(140%);
                border: 1px solid rgba(255, 255, 255, 0.14);
            }
        }

        .card h1 {
            color: #ffffff;
            font-size: 1.5rem;
            font-weight: 600;
            text-align: center;
            margin-bottom: 0.4rem;
            letter-spacing: -0.01em;
        }

        .card .subtitulo {
            text-align: center;
            font-size: 0.85rem;
            color: rgba(255,255,255,0.5);
            margin-bottom: 1.75rem;
        }

        .dispositivo {
            background: rgba(0, 0, 0, 0.28);
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 8px;
            padding: 0.7rem 0.9rem;
            margin-bottom: 1.5rem;
            font-size: 0.82rem;
            color: rgba(255, 255, 255, 0.6);
            text-align: center;
        }

        .dispositivo strong { color: #ffffff; font-family: monospace; }

        .campo { margin-bottom: 1.25rem; }

        .campo label {
            display: block;
            font-size: 0.82rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 0.5rem;
        }

        .campo input {
            width: 100%;
            padding: 0.85rem 1rem;
            background: rgba(0, 0, 0, 0.28);
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 8px;
            color: #ffffff;
            font-size: 1rem;
        }

        .campo input::placeholder { color: rgba(255, 255, 255, 0.30); }

        .campo input:focus {
            outline: none;
            border-color: var(--color-marca-primario-hover);
            box-shadow: 0 0 0 3px rgba(var(--color-marca-primario-rgb), 0.30);
            background: rgba(0, 0, 0, 0.45);
        }

        .campo input:-webkit-autofill,
        .campo input:-webkit-autofill:hover,
        .campo input:-webkit-autofill:focus {
            -webkit-text-fill-color: #ffffff;
            -webkit-box-shadow: 0 0 0px 1000px rgba(10, 14, 24, 0.55) inset;
            box-shadow: 0 0 0px 1000px rgba(10, 14, 24, 0.55) inset;
            transition: background-color 9999s ease-in-out 0s;
            caret-color: #ffffff;
        }

        button {
            width: 100%;
            padding: 0.85rem;
            background: var(--color-marca-primario);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 1.25rem;
        }

        button:hover { background: var(--color-marca-primario-hover); }
        button:disabled { background: var(--color-texto-tenue); cursor: default; }

        #mensaje {
            margin-top: 0.75rem;
            font-size: 0.85rem;
            text-align: center;
            color: var(--color-texto-tenue);
        }

        #mensaje:empty { margin-top: 0; }
        #mensaje.error { color: var(--color-peligro); }
        #mensaje.exito { color: var(--color-exito); }
    </style>

    <div class="marca-superior">
        <p class="sigla">Instituto Tecnológico de Altamira</p>
        <p class="titulo">Portal Cautivo</p>
    </div>

    <div class="card">
        <h1>Acceder a la red</h1>
        <p class="subtitulo">Inicia sesión con tu cuenta institucional</p>

        <div class="dispositivo">
            Dispositivo detectado: <strong><%= clientMac %></strong>
        </div>

        <div class="campo">
            <label for="correo">Correo</label>
            <input id="correo" type="email" placeholder="correo@altamira.tecnm.mx" autocomplete="username">
        </div>

        <div class="campo">
            <label for="password">Contraseña</label>
            <input id="password" type="password" placeholder="Contraseña" autocomplete="current-password">
        </div>

        <button id="btnLogin" onclick="login()">Acceder</button>
        <div id="mensaje"></div>
    </div>

    <script>
        const CLIENT_MAC = <%- JSON.stringify(clientMac) %>;
        const REDIRECT_FINAL = <%- JSON.stringify(redirectUrl || "http://sii.altamira.tecnm.mx/").replace(/</g, "\\u003c") %>;

        async function login() {
            const boton = document.getElementById("btnLogin");
            const mensaje = document.getElementById("mensaje");
            const correo = document.getElementById("correo").value;
            const password = document.getElementById("password").value;

            boton.disabled = true;
            boton.innerText = "Verificando...";
            mensaje.className = "";
            mensaje.innerText = "";

            try {
                const resp = await fetch("/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ correo, password, clientMac: CLIENT_MAC })
                });
                const data = await resp.json();

                if (data.ok) {
                    mensaje.className = "exito";
                    mensaje.innerText = "Acceso concedido. Redirigiendo...";
                    setTimeout(() => { window.location.href = REDIRECT_FINAL; }, 1000);
                } else {
                    mensaje.className = "error";
                    mensaje.innerText = data.mensaje;
                    boton.disabled = false;
                    boton.innerText = "Acceder";
                }
            } catch (err) {
                mensaje.className = "error";
                mensaje.innerText = "Error de conexión con el servidor.";
                boton.disabled = false;
                boton.innerText = "Acceder";
            }
        }
    </script>
</body>
</html>